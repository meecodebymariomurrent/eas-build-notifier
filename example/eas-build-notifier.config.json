{
  "services": [
    {
      "name": "telegram",
      "config": {
        "token": {
          "env": "TELEGRAM_BOT_TOKEN"
        },
        "chatID": {
          "env": "TELEGRAM_CHAT_ID"
        }
      }
    },
    {
      "name": "slack",
      "config": {
        "webhookUrl": {
          "env": "SLACK_WEBHOOK_URL"
        }
      }
    },
    {
      "name": "discord",
      "config": {
        "webhookUrl": {
          "env": "DISCORD_WEBHOOK_URL"
        }
      }
    },
    {
      "name": "teams",
      "config": {
        "webhookUrl": {
          "env": "TEAMS_WEBHOOK_URL"
        }
      }
    }
  ]
}
